{
  "name": "resolvehq-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A secure REST API for ResolveHQ, a role-based customer support and escalation platform.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
"scripts": {
  "dev": "tsx watch src/server.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/server.js",
  "typecheck": "tsc --noEmit",
  "test": "echo \"Tests not configured yet\" && exit 1",
  "db:create": "node-pg-migrate create --migration-file-language sql --migrations-dir database/migrations",
  "db:up": "node-pg-migrate up --migrations-dir database/migrations --config-file database/migrate.config.cjs --envPath .env",
  "db:down": "node-pg-migrate down --migrations-dir database/migrations --config-file database/migrate.config.cjs --envPath .env",
  "db:redo": "node-pg-migrate redo --migrations-dir database/migrations --config-file database/migrate.config.cjs --envPath .env"
},
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
